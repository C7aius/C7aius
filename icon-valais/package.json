  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stripe/stripe-react-native": "0.81.0",
    "@supabase/supabase-js": "^2.119.2",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "i18next": "^27.2.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.3",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "react-test-renderer": "^19.3.0",
    "supabase": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "e2e": "node e2e/smoke.e2e.mjs",
    "test:functions": "deno test --config supabase/functions/deno.json supabase/functions/_shared"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/supabase/functions/",
      "<rootDir>/e2e/"
    ]
  }
}
